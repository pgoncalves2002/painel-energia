# Painel de Energia — configuração.
# Copie este arquivo para ".env" e ajuste. Depois: docker compose up -d --build

# ---------------------------------------------------------------- geral
# Fuso horário usado para fechar os dias e os meses.
TZ=America/Sao_Paulo

# Porta do painel no servidor. O medidor também envia para ela (HTTP POST/GET).
PAINEL_PORT=8080

# Tarifa inicial em R$/kWh, com impostos (depois dá para mudar no painel, em Sistema).
TARIFA_KWH=0.95

# Endereço do painel na sua rede, ex.: http://192.168.0.10:8080
# Opcional: vira o botão "Visitar" do dispositivo no Home Assistant.
PUBLIC_URL=

# ---------------------------------------------------------------- MQTT e Home Assistant
# Usuário e senha do broker, usados pelo painel e pelo Home Assistant (e pelo medidor, se ele tiver esses campos).
# Deixe os dois em branco para um broker sem login (só em rede doméstica confiável).
MQTT_USERNAME=painel
MQTT_PASSWORD=troque-esta-senha

# true: quem conecta sem login só consegue ENVIAR leituras no tópico do medidor e não lê nada.
#       Assim o medidor funciona mesmo que a tela dele não tenha usuário e senha para o MQTT.
# false: ninguém conecta sem login (o medidor precisa do usuário e da senha acima).
MQTT_METER_ANONYMOUS=true

# Porta do broker no servidor (mude se a 1883 já estiver ocupada).
MQTT_PUBLIC_PORT=1883

# Tópico em que o medidor publica (configure o mesmo na tela de transmissão do medidor).
MQTT_TOPIC_IN=medidor/energia

# Já tem um broker (por exemplo, o add-on Mosquitto do Home Assistant OS)?
# Aponte para ele e remova o serviço "mosquitto" do docker-compose.yml.
# MQTT_HOST=192.168.0.20
# MQTT_PORT=1883

# Descoberta automática do Home Assistant (cria o dispositivo e os sensores sozinho).
HA_DISCOVERY=true

# ---------------------------------------------------------------- segurança (opcional)
# Login do painel. Em branco = qualquer pessoa na sua rede abre o painel.
DASH_USER=
DASH_PASSWORD=

# Com um token, o medidor precisa enviar para /api/ingest/<token> (HTTP).
INGEST_TOKEN=

# ---------------------------------------------------------------- dados
# Dias de leituras individuais guardadas (0 = para sempre).
# Os resumos de 15 minutos e a energia por período nunca são apagados.
RAW_RETENTION_DAYS=400

# Maior potência possível na sua instalação, em kW. Serve para descartar saltos absurdos
# do contador de energia; só aumente se a instalação passar disso.
MAX_POWER_KW=80

# Unidade dos contadores de energia que o medidor envia (epa_c, ept_c...): kwh ou wh.
# Deixe kwh. Só mude se a tela Sistema avisar que os contadores parecem estar em Wh.
COUNTER_UNIT=kwh

# DEMO=1 cria um medidor simulado com um mês de dados, para conhecer o painel.
# DEMO=solar faz o mesmo com geração fotovoltaica.
DEMO=0
